# Copy to .env and adjust. All optional — scripts fall back to local defaults.
# PowerShell: Copy-Item .env.example .env

# Shared Harness home. MUST be the same for DSH CLI and OpenDesign daemon.
# Default: <unified>/.dsh-home (isolated, safe to delete)
DSH_HOME=

# DSH executable. Default: "dsh" resolved from PATH.
# WARNING: DSH refuses DSH_BIN inside .env files (boot error:
# "only the launching environment may set it"). Export it in your shell:
#   PowerShell: $env:DSH_BIN="pnpm --dir C:/Users/Sahil/Downloads/deepseek-harness-master/deepseek-harness-master dsh"
#   bash:       export DSH_BIN="pnpm --dir C:/Users/Sahil/Downloads/deepseek-harness-master/deepseek-harness-master dsh"
# Do NOT uncomment DSH_BIN here.
# DSH_BIN=

# Profile OD spawns. Do not change unless you also patch
# open-design-main/apps/daemon/src/runtimes/defs/deepseek-harness.ts
DSH_PROFILE=open-design

# Real model calls need this. Probe/models/verify do NOT need it.
# DEEPSEEK_API_KEY=
